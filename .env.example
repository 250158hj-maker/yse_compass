# docker compose 用の設定例。コピーして .env を作成する。
# cp .env.example .env

POSTGRES_USER=yse_compass
POSTGRES_PASSWORD=yse_compass
POSTGRES_DB=yse_compass

# app コンテナから db コンテナへ接続する場合はホスト名を db にする。
# docker を使わずローカルの pnpm dev から接続する場合は localhost に変更する。
DATABASE_URL=postgresql://yse_compass:yse_compass@db:5432/yse_compass
