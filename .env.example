# PostgreSQL のみ docker compose で起動し、Next.js アプリはホストで直接動かす。
# cp .env.example .env

POSTGRES_USER=yse_compass
POSTGRES_PASSWORD=yse_compass
POSTGRES_DB=yse_compass

# アプリはホストから起動するため、接続先は localhost。
DATABASE_URL=postgresql://yse_compass:yse_compass@localhost:5432/yse_compass

# Auth.js × 学校 Google Workspace（docs/design/07-interface.md 7-2・requirements.md §5 の技術検証用）
# AUTH_SECRET は `pnpm exec auth secret` または `openssl rand -base64 33` で生成する。
AUTH_SECRET=
# Google Cloud Console で発行する OAuth クライアント（未検証・requirements.md §5「最大の技術リスク」）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 学校の Google Workspace ドメイン（例：yse-c.net）。サインイン制限に使う。
SCHOOL_WORKSPACE_DOMAIN=
