// このファイルは docs/design/06-data.md 6-3 から機械的に導出する（6-7）。
// 列の型・制約を変えるときは、必ず 06-data.md を先に直してからここを追随させる。
//
// 06-data.md 6-7 が挙げる「Prisma の DSL で宣言できない項目」はここに書かず、
// 最初のマイグレーション作成時に手書き SQL で追記する：
//   - DEFERRABLE INITIALLY DEFERRED（presentations の UNIQUE(event_occasion_id, display_order)）
//   - CHECK 制約 5件（users.role／event_occasions.kind／comments.label／
//     works.publication_consent／works の publication_consent と consent_set_by の相関）
//   - 部分インデックス 2件（material_slots の概要枠一意・works の publication_consent='approved'）
// そのため役割が閉じた集合の列（role・kind・label・publication_consent）も
// Prisma の enum ではなく String で宣言する（CHECK 側で守るため）。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 対応する語彙：glossary.md §2 年度
model FiscalYear {
  id         Int     @id @default(autoincrement())
  year       Int     @unique
  isArchived Boolean @default(false) @map("is_archived")

  classes        SchoolClass[]
  eventOccasions EventOccasion[]

  @@map("fiscal_years")
}

/// 対応する語彙：glossary.md §3 クラス
model SchoolClass {
  id           Int    @id @default(autoincrement())
  fiscalYearId Int    @map("fiscal_year_id")
  name         String @db.VarChar

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])
  teams      Team[]

  @@unique([fiscalYearId, name])
  @@map("classes")
}

/// 対応する語彙：glossary.md §3 チーム／リーダー
model Team {
  id             Int    @id @default(autoincrement())
  classId        Int    @map("class_id")
  name           String @db.VarChar
  leaderMemberId Int?   @map("leader_member_id")

  class         SchoolClass    @relation(fields: [classId], references: [id])
  work          Work?
  members       TeamMember[]   @relation("TeamMembersOfTeam")
  // 複合FK：teams(leader_member_id, id) → team_members(id, team_id)
  // リーダーは必ずそのチームに所属するメンバー（decisions.md 2026-09-21・2026-09-22）
  leaderMember  TeamMember?    @relation("TeamLeaderFK", fields: [leaderMemberId, id], references: [id, teamId])
  submissions   Submission[]
  summaries     Summary[]
  presentations Presentation[]

  @@unique([classId, name])
  // Prismaが1-1のcomposite relationを解決するために要求する追加のunique
  // （idは既にPKなので冗長だが、Prisma側の制約として必要。06-data.mdの定義には無い）
  @@unique([leaderMemberId, id])
  @@map("teams")
}

/// 対応する語彙：glossary.md §3 メンバー／リーダー（H-29・2026-09-21決着）
model TeamMember {
  id     Int    @id @default(autoincrement())
  teamId Int    @map("team_id")
  name   String @db.VarChar
  userId Int?   @unique @map("user_id")

  team    Team  @relation("TeamMembersOfTeam", fields: [teamId], references: [id])
  user    User? @relation(fields: [userId], references: [id])
  // Team.leaderMemberId からの複合FKの受け口（1メンバーは高々1チームのリーダー）
  ledTeam Team? @relation("TeamLeaderFK")

  @@unique([id, teamId])
  @@map("team_members")
}

/// 対応する語彙：glossary.md §6 作品／公開許可
model Work {
  id                 Int     @id @default(autoincrement())
  teamId             Int     @unique @map("team_id")
  title              String? @db.VarChar
  publicationConsent String  @default("unset") @map("publication_consent") @db.VarChar
  consentSetBy       Int?    @map("consent_set_by")

  team             Team  @relation(fields: [teamId], references: [id])
  consentSetByUser User? @relation(fields: [consentSetBy], references: [id])

  @@map("works")
}

/// 対応する語彙：glossary.md §3 ユーザーとロール
model User {
  id    Int    @id @default(autoincrement())
  email String @unique @db.VarChar
  name  String @db.VarChar
  role  String @default("student") @db.VarChar

  teamMember        TeamMember?
  worksConsentSet   Work[]
  comments          Comment[]
  presentationLikes PresentationLike[]
  commentLikes      CommentLike[]

  @@map("users")
}

/// 対応する語彙：glossary.md §2 発表会
model EventOccasion {
  id                    Int       @id @default(autoincrement())
  fiscalYearId          Int       @map("fiscal_year_id")
  kind                  String    @db.VarChar
  eventDate             DateTime? @map("event_date") @db.Date
  isPublished           Boolean   @default(false) @map("is_published")
  currentPresentationId Int?      @map("current_presentation_id")

  fiscalYear          FiscalYear     @relation(fields: [fiscalYearId], references: [id])
  materialSlots       MaterialSlot[]
  presentations       Presentation[] @relation("EventPresentations")
  summaries           Summary[]
  // 複合FK：event_occasions(current_presentation_id, id) → presentations(id, event_occasion_id)
  // 「いま発表中」は自分自身の発表会に属する発表しか指せない（decisions.md 2026-09-21）
  currentPresentation Presentation?  @relation("CurrentPresentationFK", fields: [currentPresentationId, id], references: [id, eventOccasionId])

  // Prismaが1-1のcomposite relationを解決するために要求する追加のunique
  // （idは既にPKなので冗長だが、Prisma側の制約として必要。06-data.mdの定義には無い）
  @@unique([currentPresentationId, id])
  @@map("event_occasions")
}

/// 対応する語彙：glossary.md §2 資料枠
model MaterialSlot {
  id              Int       @id @default(autoincrement())
  eventOccasionId Int       @map("event_occasion_id")
  slotType        String    @map("slot_type") @db.VarChar
  deadline        DateTime?
  isRequired      Boolean   @map("is_required")
  templateUrl     String?   @map("template_url") @db.Text

  eventOccasion EventOccasion @relation(fields: [eventOccasionId], references: [id])
  submissions   Submission[]

  @@map("material_slots")
}

/// 対応する語彙：glossary.md §4 提出（概要枠を除く）
model Submission {
  id               Int      @id @default(autoincrement())
  teamId           Int      @map("team_id")
  materialSlotId   Int      @map("material_slot_id")
  url              String   @db.Text
  firstSubmittedAt DateTime @map("first_submitted_at")
  lastSubmittedAt  DateTime @map("last_submitted_at")

  team         Team         @relation(fields: [teamId], references: [id])
  materialSlot MaterialSlot @relation(fields: [materialSlotId], references: [id])

  @@unique([teamId, materialSlotId])
  @@map("submissions")
}

/// 対応する語彙：glossary.md §5 概要
model Summary {
  id               Int      @id @default(autoincrement())
  teamId           Int      @map("team_id")
  eventOccasionId  Int      @map("event_occasion_id")
  techStack        String?  @map("tech_stack") @db.Text
  firstSubmittedAt DateTime @map("first_submitted_at")
  lastSubmittedAt  DateTime @map("last_submitted_at")

  team          Team          @relation(fields: [teamId], references: [id])
  eventOccasion EventOccasion @relation(fields: [eventOccasionId], references: [id])

  @@unique([teamId, eventOccasionId])
  @@map("summaries")
}

/// 対応する語彙：glossary.md §4 発表／発表順
model Presentation {
  id              Int  @id @default(autoincrement())
  teamId          Int  @map("team_id")
  eventOccasionId Int  @map("event_occasion_id")
  // UNIQUE(event_occasion_id, display_order) は DEFERRABLE INITIALLY DEFERRED が要る
  // （並び替え時の一時的な重複を許すため）。Prisma DSL は deferrable を宣言できない
  // （06-data.md 6-7）ので、@@unique はここでは張らず、手書きマイグレーションで追加する。
  displayOrder    Int? @map("display_order")

  team          Team               @relation(fields: [teamId], references: [id])
  eventOccasion EventOccasion      @relation("EventPresentations", fields: [eventOccasionId], references: [id])
  comments      Comment[]
  likes         PresentationLike[]
  // EventOccasion.currentPresentationId からの複合FKの受け口
  currentFor    EventOccasion?     @relation("CurrentPresentationFK")

  @@unique([id, eventOccasionId])
  @@unique([teamId, eventOccasionId])
  @@map("presentations")
}

/// 対応する語彙：glossary.md §4 発表（コメントのアンカー）／requirements.md §3-9
model Comment {
  id              Int      @id @default(autoincrement())
  presentationId  Int      @map("presentation_id")
  userId          Int      @map("user_id")
  parentCommentId Int?     @map("parent_comment_id")
  label           String?  @db.VarChar
  body            String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  presentation Presentation  @relation(fields: [presentationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  parent       Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies      Comment[]     @relation("CommentReplies")
  likes        CommentLike[]

  @@map("comments")
}

/// 対応する語彙：glossary.md §4／requirements.md §3-9
model PresentationLike {
  id             Int @id @default(autoincrement())
  presentationId Int @map("presentation_id")
  userId         Int @map("user_id")

  presentation Presentation @relation(fields: [presentationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([presentationId, userId])
  @@map("presentation_likes")
}

/// 対応する語彙：glossary.md §4／requirements.md §3-9
model CommentLike {
  id        Int @id @default(autoincrement())
  commentId Int @map("comment_id")
  userId    Int @map("user_id")

  comment Comment @relation(fields: [commentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@map("comment_likes")
}
